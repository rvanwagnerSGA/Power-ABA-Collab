        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|sunken|warm|red|indigo|yellow|teal|solid)$/]",
        "message": "<Card> tone must be one of 'plain' | 'sunken' | 'warm' | 'red' | 'indigo' | 'yellow' | 'teal' | 'solid'."
